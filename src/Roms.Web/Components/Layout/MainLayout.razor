@implements IAsyncDisposable
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS

<AuthorizeView>
    <Authorized><SessionTimeout /></Authorized>
</AuthorizeView>

<div class="page @(isKitchenPage ? "kds-mode" : "standard-mode")">
    <!-- Sidebar / Mobile Navigation -->
    <div class="sidebar @(isKitchenPage ? "" : "mobile-sidebar-only")">
        <NavMenu IsHorizontal="false" />
    </div>

    <main>
        <div class="top-row px-4">
            <div class="d-flex align-items-center justify-content-between w-100">
                <div class="d-flex align-items-center gap-4">
                    <strong class="roms-brand-title">@ProductBrand.Name</strong>
                    @if (!isKitchenPage)
                    {
                    }
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span id="roms-connection-indicator"
                          class="connection-indicator status-@connectionState.ToLowerInvariant()"
                          role="status"
                          aria-live="polite">● @GetConnectionLabel(connectionState)</span>
                    <AuthorizeView>
                        <Authorized>
                            <span class="user-badge">● @context.User.Identity?.Name (@GetRole(context.User))</span>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool isKitchenPage;
    private string connectionState = "Connected";
    private DotNetObjectReference<MainLayout>? dotNetRef;

    protected override void OnInitialized()
    {
        UpdatePageType(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("romsConnection.init", dotNetRef);
            }
            catch
            {
                // Prerendering or JS fallback
            }
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdatePageType(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void UpdatePageType(string uri)
    {
        var relative = Navigation.ToBaseRelativePath(uri).Trim('/');
        isKitchenPage = string.Equals(relative, "kitchen", StringComparison.OrdinalIgnoreCase);
    }

    [JSInvokable]
    public void UpdateConnectionState(string state)
    {
        if (connectionState != state)
        {
            connectionState = state;
            InvokeAsync(StateHasChanged);
        }
    }

    private static string GetRole(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole(RomsRoles.Admin)) return "Admin";
        if (user.IsInRole(RomsRoles.Waiter)) return "Waiter";
        if (user.IsInRole(RomsRoles.Kitchen)) return "Kitchen";
        if (user.IsInRole(RomsRoles.Manager)) return "Manager";
        return "Staff";
    }

    private static string GetConnectionLabel(string state) => state switch
    {
        "Reconnecting" => "Reconnecting",
        "Offline" => "Connection lost",
        _ => "Connected"
    };

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        if (dotNetRef is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("romsConnection.dispose");
            }
            catch
            {
                // Circuit disconnected
            }
            dotNetRef.Dispose();
            dotNetRef = null;
        }
    }
}
