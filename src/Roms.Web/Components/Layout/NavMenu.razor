@implements IDisposable
@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid"><a class="navbar-brand" href="">ROMS</a></div>
</div>
<input type="checkbox" title="Navigation menu" class="navbar-toggler" />
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3"><NavLink class="nav-link" href="" Match="NavLinkMatch.All">⌂ Dashboard</NavLink></div>
        <AuthorizeView><div class="nav-item px-3"><NavLink class="nav-link" href="attendance">◷ My Attendance</NavLink></div></AuthorizeView>
        <div class="nav-item px-3 install-nav-item"><NavLink class="nav-link" href="install">⬇ Install ROMS</NavLink></div>
        <AuthorizeView Policy="WaiterOrAdmin"><div class="nav-item px-3"><NavLink class="nav-link" href="tables">▦ Tables & Orders</NavLink></div></AuthorizeView>
        <AuthorizeView Policy="KitchenOrAdmin"><div class="nav-item px-3"><NavLink class="nav-link" href="kitchen">▤ Kitchen Display</NavLink></div></AuthorizeView>
        <AuthorizeView Roles="Admin">
            <div class="nav-item px-3"><NavLink class="nav-link" href="admin/catalog">☰ Menu & Tables</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="admin/users">♙ Users</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="admin/attendance">◴ Staff Schedule</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="admin/payments">₱ Pending Payments</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="reports">◫ Reports</NavLink></div>
            <div class="nav-item px-3"><NavLink class="nav-link" href="inventory">▥ Inventory</NavLink></div>
        </AuthorizeView>
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3"><NavLink class="nav-link" href="Account/Manage">● @context.User.Identity?.Name</NavLink></div>
                <div class="nav-item px-3"><form action="Account/ClockOutAndLogout" method="post"><AntiforgeryToken /><button type="submit" class="nav-link nav-clockout">⇥ Clock Out + Log Out</button></form></div>
                <div class="nav-item px-3"><form action="Account/Logout" method="post"><AntiforgeryToken /><input type="hidden" name="ReturnUrl" value="Account/Login" /><button type="submit" class="nav-link nav-session-logout">Log Out Only</button></form></div>
            </Authorized>
            <NotAuthorized><div class="nav-item px-3"><NavLink class="nav-link" href="Account/Login">● Staff Login</NavLink></div></NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;
    protected override void OnInitialized() { currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri); NavigationManager.LocationChanged += OnLocationChanged; }
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) { currentUrl = NavigationManager.ToBaseRelativePath(e.Location); StateHasChanged(); }
    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
