@page "/orders/{OrderId:guid}"
@attribute [Authorize(Policy = "WaiterOrAdmin")]
@inject IOrderService Orders
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject OrderEventBus Events
@implements IDisposable

<PageTitle>Order</PageTitle>
@if (!string.IsNullOrEmpty(error)) { <div class="alert alert-danger">@error</div> }
@if (order is null) { <p>Loading order…</p> }
else
{
    <div class="page-heading"><div><h1>Table @order.TableNumber</h1><span class="status-pill status-@order.Status.ToString().ToLowerInvariant()">@order.Status</span> <small>Waiter: @order.WaiterName · Revision @order.Revision</small></div><button class="btn btn-outline-secondary touch-button" @onclick="Back">Back</button></div>
    <div class="order-layout">
        <section>
            <h2>Current order</h2>
            @if (order.Items.Count == 0) { <div class="empty-state">No items yet.</div> }
            @foreach (var item in order.Items.Where(x => !x.IsRemoved))
            {
                <div class="order-line"><div><strong>@item.Quantity × @item.Name</strong>@if (!string.IsNullOrWhiteSpace(item.Notes)) { <small>@item.Notes</small> }</div><span>₱@((item.UnitPrice * item.Quantity).ToString("N2"))</span>@if (order.Status == OrderStatus.Draft || order.Status == OrderStatus.New || (order.Status == OrderStatus.Preparing && isAdmin)) { <button class="btn btn-sm btn-outline-danger" disabled="@busy" @onclick="() => Remove(item.Id)">Remove</button> }</div>
            }
            <div class="order-total"><span>Total</span><strong>₱@order.Total.ToString("N2")</strong></div>
            @if (order.Status == OrderStatus.Draft) { <button class="btn btn-success btn-lg touch-button w-100" disabled="@(busy || order.Items.Count == 0)" @onclick="Submit">Send to kitchen</button> }
            else if (order.Status == OrderStatus.Ready) { <button class="btn btn-success btn-lg touch-button w-100" disabled="@busy" @onclick="Complete">Mark served</button> }
            else if (order.Status == OrderStatus.Completed && order.PaymentConfirmedUtc is null) { <div class="alert alert-warning"><strong>Pending payment.</strong> The table will be released after Admin confirms payment.</div> }
            else if (order.Status == OrderStatus.Completed) { <div class="alert alert-success">Payment confirmed and order completed.</div> }
            else if (order.Status == OrderStatus.Cancelled)
            {
                <div class="alert alert-secondary">
                    <strong>Order cancelled.</strong>
                    @order.CancellationReason
                    @if (order.CancellationInventoryDisposition is not null)
                    {
                        <span> Inventory: @DispositionLabel(order.CancellationInventoryDisposition.Value).</span>
                    }
                </div>
            }
            else { <div class="alert alert-info">Kitchen status: <strong>@order.Status</strong></div> }
            @if (order.Status is not (OrderStatus.Completed or OrderStatus.Cancelled) && (isAdmin || order.Status is OrderStatus.Draft or OrderStatus.New))
            {
                <div class="cancel-panel">
                    <input class="form-control" placeholder="Cancellation reason (required)" @bind="cancellationReason" />
                    @if (order.Status is OrderStatus.Preparing or OrderStatus.Ready)
                    {
                        <label class="form-label" for="cancellation-inventory-disposition">Inventory disposition for cancellation</label>
                        <select id="cancellation-inventory-disposition" class="form-select" @bind="cancellationInventoryDisposition">
                            <option value="">Choose inventory disposition</option>
                            <option value="@InventoryDisposition.ReturnToStock">Return ingredients to stock</option>
                            <option value="@InventoryDisposition.ConsumedAsWasteOrStaffMeal">Consumed as waste or staff meal</option>
                        </select>
                    }
                    <button class="btn btn-outline-danger touch-button" disabled="@busy" @onclick="Cancel">Cancel order</button>
                </div>
            }
        </section>
        @if (order.Status is OrderStatus.Draft or OrderStatus.New or OrderStatus.Preparing)
        {
            <section><h2>@(order.Status == OrderStatus.Draft ? "Add menu items" : "Amend order")</h2>
                @if (order.Status != OrderStatus.Draft)
                {
                    <div class="alert alert-warning">
                        Kitchen will be notified.
                        <input class="form-control mt-2" placeholder="Amendment reason (required)" @bind="amendmentReason" />
                        @if (order.Status == OrderStatus.Preparing && isAdmin)
                        {
                            <label class="form-label mt-2" for="removal-inventory-disposition">When removing a prepared item</label>
                            <select id="removal-inventory-disposition" class="form-select" @bind="removalInventoryDisposition">
                                <option value="">Choose inventory disposition</option>
                                <option value="@InventoryDisposition.ReturnToStock">Return ingredients to stock</option>
                                <option value="@InventoryDisposition.ConsumedAsWasteOrStaffMeal">Consumed as waste or staff meal</option>
                            </select>
                        }
                    </div>
                }
                <div class="input-row"><input class="form-control" placeholder="Special instructions" @bind="notes" /><input class="form-control quantity" type="number" min="1" max="99" @bind="quantity" /></div>
                @foreach (var group in menu.GroupBy(x => x.Category)) { <h3>@group.Key</h3><div class="menu-grid">@foreach (var item in group) { <button class="menu-card" disabled="@busy" @onclick="() => Add(item.Id)"><strong>@item.Name</strong><span>₱@item.Price.ToString("N2")</span><small>@item.Description</small></button> }</div> }
            </section>
        }
    </div>
}

@code {
    [Parameter] public Guid OrderId { get; set; }
    private OrderView? order; private IReadOnlyList<MenuItemChoice> menu = []; private string notes = "", amendmentReason = "", cancellationReason = ""; private int quantity = 1; private bool busy, isAdmin; private string? error; private string actor = "unknown"; private string submissionKey = Guid.NewGuid().ToString("N"); private InventoryDisposition? removalInventoryDisposition, cancellationInventoryDisposition;
    protected override async Task OnInitializedAsync() { var state = await Authentication.GetAuthenticationStateAsync(); actor = state.User.Identity?.Name ?? "unknown"; isAdmin = state.User.IsInRole(RomsRoles.Admin); Events.Changed += OnChanged; }
    protected override async Task OnParametersSetAsync() => await Load();
    private async Task Load() { try { order = await Orders.GetOrderAsync(OrderId, actor); menu = await Orders.GetMenuAsync(); if (order is null) error = "Order not found."; } catch (Exception ex) { order = null; error = ex.Message; } }
    private async Task Add(Guid menuId) => await Run(async () => { if (order!.Status == OrderStatus.Draft) await Orders.AddItemAsync(OrderId, menuId, quantity, notes, actor); else await Orders.AmendAddItemAsync(OrderId, menuId, quantity, notes, amendmentReason, actor); notes = amendmentReason = ""; quantity = 1; });
    private async Task Remove(Guid itemId) => await Run(async () => { if (order!.Status == OrderStatus.Draft) await Orders.RemoveDraftItemAsync(OrderId, itemId, actor); else await Orders.AmendRemoveItemAsync(OrderId, itemId, amendmentReason, actor, inventoryDisposition: removalInventoryDisposition); amendmentReason = ""; removalInventoryDisposition = null; });
    private async Task Submit() => await Run(async () => { await Orders.SubmitAsync(OrderId, submissionKey, actor); submissionKey = Guid.NewGuid().ToString("N"); });
    private async Task Complete() => await Run(() => Orders.TransitionAsync(OrderId, OrderStatus.Completed, actor));
    private async Task Cancel() => await Run(async () => { await Orders.TransitionAsync(OrderId, OrderStatus.Cancelled, actor, cancellationReason, inventoryDisposition: cancellationInventoryDisposition); cancellationReason = ""; cancellationInventoryDisposition = null; });
    private static string DispositionLabel(InventoryDisposition disposition) => disposition == InventoryDisposition.ReturnToStock
        ? "ingredients returned to stock"
        : "ingredients retained as consumed waste or staff meal";
    private void OnChanged(OrderEvent message) { if(message.OrderId==OrderId) _=InvokeAsync(async()=>{await Load();StateHasChanged();}); }
    private void Back() => Navigation.NavigateTo("tables");
    private async Task Run(Func<Task> action) { if (busy) return; busy = true; error = null; try { await action(); await Load(); } catch (Exception ex) { error = ex.Message; } finally { busy = false; } }
    public void Dispose()=>Events.Changed-=OnChanged;
}
