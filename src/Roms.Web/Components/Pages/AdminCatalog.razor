@page "/admin/catalog"
@attribute [Authorize(Roles = "Admin")]
@inject ICatalogService Catalog
@inject AuthenticationStateProvider Authentication

<PageTitle>Menu & Tables</PageTitle>
<h1>Menu and tables</h1>
@if (!string.IsNullOrEmpty(message)) { <div class="alert @(failed ? "alert-danger" : "alert-success")">@message</div> }
<div class="admin-grid">
 <section class="panel"><h2>Tables</h2><div class="input-row"><input class="form-control" placeholder="Table number" @bind="newTable.Number" /><input class="form-control quantity" type="number" @bind="newTable.SortOrder" /><button class="btn btn-primary touch-button" @onclick="AddTable">Add</button></div><div class="admin-list">@foreach (var table in tables) { <div><span>Table @table.Number</span><button class="btn btn-sm @(table.IsActive ? "btn-outline-success" : "btn-outline-secondary")" @onclick="() => ToggleTable(table)">@(table.IsActive ? "Active" : "Inactive")</button></div> }</div></section>
 <section class="panel"><h2>Categories</h2><div class="input-row"><input class="form-control" placeholder="Category name" @bind="newCategory.Name" /><input class="form-control quantity" type="number" @bind="newCategory.SortOrder" /><button class="btn btn-primary touch-button" @onclick="AddCategory">Add</button></div><div class="admin-list">@foreach (var category in categories) { <div><span>@category.Name</span><button class="btn btn-sm @(category.IsActive ? "btn-outline-success" : "btn-outline-secondary")" @onclick="() => ToggleCategory(category)">@(category.IsActive ? "Active" : "Inactive")</button></div> }</div></section>
</div>
<section class="panel mt-4"><h2>Menu items</h2>
 @if (categories.Count == 0) { <p>Add a category before adding menu items.</p> }
 else { <div class="menu-form"><select class="form-select" @bind="newItem.CategoryId">@foreach (var category in categories.Where(x => x.IsActive)) { <option value="@category.Id">@category.Name</option> }</select><input class="form-control" placeholder="Item name" @bind="newItem.Name" /><input class="form-control" placeholder="Description" @bind="newItem.Description" /><input class="form-control" type="number" step="0.01" min="0" @bind="newItem.Price" /><button class="btn btn-primary touch-button" @onclick="AddItem">Add menu item</button></div><div class="admin-list mt-3">@foreach (var category in categories) { @foreach (var item in category.Items.OrderBy(x => x.Name)) { <div><span><strong>@item.Name</strong> · @category.Name · ₱@item.Price.ToString("N2")</span><div><button class="btn btn-sm @(item.IsAvailable ? "btn-outline-success" : "btn-outline-warning")" @onclick="() => ToggleAvailable(item)">@(item.IsAvailable ? "Available" : "Unavailable")</button> <button class="btn btn-sm @(item.IsActive ? "btn-outline-success" : "btn-outline-secondary")" @onclick="() => ToggleItem(item)">@(item.IsActive ? "Active" : "Inactive")</button></div></div> } }</div> }
</section>
@code {
 private IReadOnlyList<RestaurantTable> tables=[]; private IReadOnlyList<MenuCategory> categories=[]; private RestaurantTable newTable=new(); private MenuCategory newCategory=new(); private MenuItem newItem=new(); private string actor="unknown"; private string? message; private bool failed;
 protected override async Task OnInitializedAsync(){var state=await Authentication.GetAuthenticationStateAsync();actor=state.User.Identity?.Name??"unknown";await Load();}
 private async Task Load(){tables=await Catalog.GetTablesAsync();categories=await Catalog.GetCategoriesAsync();var active=categories.FirstOrDefault(x=>x.IsActive);if(newItem.CategoryId==Guid.Empty&&active is not null)newItem.CategoryId=active.Id;}
 private Task AddTable()=>Run(async()=>{await Catalog.SaveTableAsync(newTable,actor);newTable=new();}); private Task ToggleTable(RestaurantTable x)=>Run(async()=>{x.IsActive=!x.IsActive;await Catalog.SaveTableAsync(x,actor);});
 private Task AddCategory()=>Run(async()=>{await Catalog.SaveCategoryAsync(newCategory,actor);newCategory=new();}); private Task ToggleCategory(MenuCategory x)=>Run(async()=>{x.IsActive=!x.IsActive;await Catalog.SaveCategoryAsync(x,actor);});
 private Task AddItem()=>Run(async()=>{await Catalog.SaveMenuItemAsync(newItem,actor);newItem=new MenuItem{CategoryId=categories.First(x=>x.IsActive).Id};}); private Task ToggleAvailable(MenuItem x)=>Run(async()=>{x.IsAvailable=!x.IsAvailable;await Catalog.SaveMenuItemAsync(x,actor);}); private Task ToggleItem(MenuItem x)=>Run(async()=>{x.IsActive=!x.IsActive;await Catalog.SaveMenuItemAsync(x,actor);});
 private async Task Run(Func<Task> action){try{await action();message="Saved.";failed=false;await Load();}catch(Exception ex){message=ex.Message;failed=true;}}
}
