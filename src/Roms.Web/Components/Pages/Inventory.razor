@page "/inventory"
@attribute [Authorize(Policy = "KitchenManagerOrAdmin")]
@inject IInventoryService InventoryService
@inject ICatalogService CatalogService
@inject AuthenticationStateProvider Authentication

<PageTitle>Inventory</PageTitle>
<h1>Inventory</h1>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert @(failed ? "alert-danger" : "alert-success") mb-4">@message</div>
}

@if (isAdmin && readiness is not null)
{
    <section class="panel mb-4 glass-card" aria-labelledby="inventory-readiness-heading">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <h2 id="inventory-readiness-heading">Inventory readiness</h2>
                <p class="mb-1 text-muted">Technical checks checklist for the external auditor.</p>
                <small class="text-muted">Last evaluated @readiness.EvaluatedUtc.ToLocalTime().ToString("g")</small>
            </div>
            <span class="status-badge @(readiness.TechnicalChecksPassed ? "status-ready" : "status-cancelled")">
                @(readiness.TechnicalChecksPassed ? "Technical checks passed" : $"{readiness.BlockingIssueCount} blocker(s)")
            </span>
        </div>
        <div class="mt-3 list-group list-group-flush">
            @foreach (var check in readiness.Checks)
            {
                <div class="list-group-item bg-transparent text-white d-flex justify-content-between align-items-center px-0">
                    <div>
                        <strong>@check.Code · @check.Name</strong>
                        <div class="small text-muted">@check.Evidence</div>
                    </div>
                    <span class="status-badge @ReadinessClass(check.Status)">@ReadinessLabel(check.Status)</span>
                </div>
            }
        </div>
        <p class="mt-3 mb-0 text-muted small"><strong>Notice:</strong> Production database is supervised until final pilot audit approvals are confirmed.</p>
    </section>
}

@if (isAdmin)
{
    <!-- Bento Grid Container -->
    <div class="bento-grid mb-4" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 1.25rem;">

        <!-- Add inventory item -->
        <section class="panel glass-card p-3 d-flex flex-column">
            <h2>Add inventory item</h2>
            <p class="text-muted small mb-2">Configure raw items. Supplier cost and barcode mapping are currently disabled.</p>
            <div class="user-form mt-auto">
                <div class="mb-3">
                    <label class="form-label">Item Name</label>
                    <input class="form-control" placeholder="Name" @bind="newItemName" @bind:event="oninput" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Unit of Measure</label>
                    <select class="form-select" @bind="newItemUnit">
                        <option value="piece">piece</option>
                        <option value="g">g</option>
                        <option value="ml">ml</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Minimum Safety Stock</label>
                    <input class="form-control" type="number" min="0" step="0.001" placeholder="Minimum stock" @bind="newMinimumStock" />
                </div>
                <button class="btn btn-primary touch-button w-100" disabled="@(busy || string.IsNullOrWhiteSpace(newItemName))" @onclick="SaveItem">Add item</button>
            </div>
        </section>

        <!-- Receive stock -->
        <section class="panel glass-card p-3 d-flex flex-column">
            <h2>Receive stock</h2>
            <p class="text-muted small mb-2">Record a delivery as a positive receipt with its delivery or reference.</p>
            @if (HasActiveInventoryItems)
            {
                <div class="user-form mt-auto">
                    <div class="mb-2">
                        <label class="form-label small">Select Item</label>
                        <select class="form-select" aria-label="Received inventory item" @bind="receiveItemId">
                            @foreach (var item in items.Where(x => x.IsActive))
                            {
                                <option value="@item.Id">@item.Name (@item.Unit)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Received Quantity</label>
                        <input class="form-control" type="number" min="0.001" step="0.001" placeholder="Received quantity" @bind="receivedQuantity" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Delivery or Invoice Ref (Required)</label>
                        <input class="form-control" maxlength="120" placeholder="Delivery or invoice reference (required)" @bind="deliveryReference" @bind:event="oninput" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Notes (Optional)</label>
                        <input class="form-control" maxlength="350" placeholder="Delivery note (optional)" @bind="deliveryNote" @bind:event="oninput" />
                    </div>
                    <button class="btn btn-primary touch-button w-100 mt-2" disabled="@(busy || receiveItemId == Guid.Empty || string.IsNullOrWhiteSpace(deliveryReference))" @onclick="Receive">Post receipt</button>
                </div>
            }
            else
            {
                <div class="empty-state my-auto">No items configured.</div>
            }
        </section>

        <!-- Physical count reconciliation -->
        <section class="panel glass-card p-3 d-flex flex-column">
            <h2>Physical count reconciliation</h2>
            <p class="text-muted small mb-2">Record a physical witness count reconciliation.</p>
            @if (HasActiveInventoryItems)
            {
                <div class="user-form mt-auto">
                    <div class="mb-2">
                        <label class="form-label small">Select Item</label>
                        <select class="form-select" aria-label="Counted inventory item" @bind="countItemId">
                            @foreach (var item in items.Where(x => x.IsActive))
                            {
                                <option value="@item.Id">@item.Name (@item.Unit)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Witness Count Quantity</label>
                        <input class="form-control" type="number" min="0" step="0.001" placeholder="Physical quantity counted" @bind="countedQuantity" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Count Reason / Sheet Ref (Required)</label>
                        <input class="form-control" placeholder="Count reason or count-sheet reference (required)" @bind="countReason" @bind:event="oninput" />
                    </div>
                    <button class="btn btn-success touch-button w-100 mt-3" disabled="@(busy || countItemId == Guid.Empty || string.IsNullOrWhiteSpace(countReason))" @onclick="ReconcileCount">Reconcile count</button>
                </div>
            }
            else
            {
                <div class="empty-state my-auto">No items configured.</div>
            }
        </section>

        <!-- Stock adjustment -->
        <section class="panel glass-card p-3 d-flex flex-column">
            <h2>Stock adjustment</h2>
            <p class="text-muted small mb-2">Execute manual adjustments to current balances.</p>
            @if (HasActiveInventoryItems)
            {
                <div class="user-form mt-auto">
                    <div class="mb-2">
                        <label class="form-label small">Select Item</label>
                        <select class="form-select" aria-label="Adjusted inventory item" @bind="adjustItemId">
                            @foreach (var item in items.Where(x => x.IsActive))
                            {
                                <option value="@item.Id">@item.Name (@item.Unit)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Adjustment Delta</label>
                        <input class="form-control" type="number" step="0.001" placeholder="Quantity Delta" @bind="adjustment" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Adjustment Reason (Required)</label>
                        <input class="form-control" placeholder="Adjustment reason" @bind="adjustmentReason" @bind:event="oninput" />
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="allowNegativeAdjustment" @bind="allowNegativeAdjustment" />
                        <label class="form-check-label text-muted small" for="allowNegativeAdjustment">Allow negative balance override</label>
                    </div>
                    @if (allowNegativeAdjustment)
                    {
                        <div class="mb-2">
                            <label class="form-label small text-warning">Negative Balance Reason (Required)</label>
                            <input class="form-control" placeholder="Reason for negative stock override" @bind="adjustmentOverrideReason" @bind:event="oninput" />
                        </div>
                    }
                    <button class="btn btn-primary touch-button w-100 mt-2" disabled="@(busy || adjustItemId == Guid.Empty || string.IsNullOrWhiteSpace(adjustmentReason) || (allowNegativeAdjustment && string.IsNullOrWhiteSpace(adjustmentOverrideReason)))" @onclick="Adjust">Post adjustment</button>
                </div>
            }
            else
            {
                <div class="empty-state my-auto">No items configured.</div>
            }
        </section>



        <!-- Bottom-Right: Current Balances -->
        <section class="panel glass-card p-3 d-flex flex-column">
            <h2>Current balances</h2>
            <div class="table-responsive mt-3" style="max-height: 380px; overflow-y: auto;">
                @if (balances.Count == 0)
                {
                    <div class="empty-state text-center py-5 text-muted">No items configured. Add items to see stock levels.</div>
                }
                else
                {
                    <table class="table table-dark table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Item Name</th>
                                <th class="text-end">Current Stock</th>
                                <th class="text-end">Minimum</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in balances)
                            {
                                <tr class="@(item.IsLow ? "low-stock" : "")">
                                    <td><strong>@item.Name</strong> <small class="text-muted">(@item.Unit)</small></td>
                                    <td class="text-end font-monospace">@item.CurrentStock.ToString("N3") @item.Unit</td>
                                    <td class="text-end font-monospace text-muted">@item.MinimumStock.ToString("N3")</td>
                                    <td class="text-center">
                                        @if (item.IsLow)
                                        {
                                            <span class="status-badge status-cancelled">LOW STOCK</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-ready">OK</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </section>
    </div>



    <div class="row">
        <!-- Physical Count History -->
        <div class="col-md-6 mb-4">
            <section class="glass-card p-3 h-100">
                <h2>Recent physical counts logs</h2>
                @if (counts.Count == 0)
                {
                    <p class="text-muted small">No physical counts logged.</p>
                }
                else
                {
                    <div class="list-group list-group-flush" style="max-height: 250px; overflow-y: auto;">
                        @foreach (var count in counts)
                        {
                            <div class="list-group-item bg-transparent text-white px-0 py-2 border-secondary">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong>@count.InventoryItemName: @count.CountedQuantity.ToString("N3") @count.Unit counted</strong>
                                        <div class="small text-muted">Ledger: @count.LedgerQuantity.ToString("N3") · Counted: @count.CountedQuantity.ToString("N3")</div>
                                        <div class="small text-warning">Variance: @Signed(count.Variance) · @count.Reason</div>
                                    </div>
                                    <div class="text-end small text-muted">
                                        <div>@count.CountedBy</div>
                                        <div>@count.CountedUtc.ToLocalTime().ToString("t")</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>

        <!-- Recent Activity Feed -->
        <div class="col-md-6 mb-4">
            <section class="glass-card p-3 h-100">
                <h2>Recent stock activity feed</h2>
                @if (movements.Count == 0)
                {
                    <p class="text-muted small">No movements tracked.</p>
                }
                else
                {
                    <div class="list-group list-group-flush" style="max-height: 250px; overflow-y: auto;">
                        @foreach (var movement in movements)
                        {
                            <div class="list-group-item bg-transparent text-white px-0 py-2 border-secondary">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong>@movement.Type: @Signed(movement.QuantityDelta) @movement.Unit @movement.InventoryItemName</strong>
                                        <div class="small text-muted">Reason: @movement.Reason</div>
                                    </div>
                                    <div class="text-end small text-muted">
                                        <div>@movement.ActorId</div>
                                        <div>@movement.OccurredUtc.ToLocalTime().ToString("t")</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>
    </div>
}
else
{
    <!-- Kitchen User view of Balances only -->
    <section class="glass-card p-4">
        <h2>Current Inventory Balances</h2>
        <div class="table-responsive mt-3">
            @if (balances.Count == 0)
            {
                <p class="text-muted">No items configured.</p>
            }
            else
            {
                <table class="table table-dark table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Item Name</th>
                            <th class="text-end">Current Stock</th>
                            <th class="text-end">Minimum</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in balances)
                        {
                            <tr>
                                <td><strong>@item.Name</strong> <small class="text-muted">(@item.Unit)</small></td>
                                <td class="text-end font-monospace">@item.CurrentStock.ToString("N3") @item.Unit</td>
                                <td class="text-end font-monospace text-muted">@item.MinimumStock.ToString("N3")</td>
                                <td class="text-center">
                                    @if (item.IsLow)
                                    {
                                        <span class="status-badge status-cancelled">LOW STOCK</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-ready">OK</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </section>
}

<!-- Menu Item Availability (86 / 68) — visible to Admin, Kitchen, and Manager -->
<section class="glass-card p-4 mb-4">
    <h2>Menu Item Availability (86 / 68)</h2>
    <p class="text-muted small mb-3">Toggle operational availability of menu items. This action does not alter inventory stock levels.</p>
    @if (categories.Count == 0)
    {
        <div class="empty-state text-center py-3 text-muted">No menu items configured.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle">
                <thead>
                    <tr>
                        <th>Menu Item</th>
                        <th>Category</th>
                        <th>Prep Time</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in categories)
                    {
                        @foreach (var item in category.Items.Where(x => x.IsActive).OrderBy(x => x.Name))
                        {
                            <tr>
                                <td><strong>@item.Name</strong></td>
                                <td>@category.Name</td>
                                <td>@item.PreparationMinutes mins</td>
                                <td class="text-center">
                                    @if (item.IsAvailable)
                                    {
                                        <span class="status-badge status-ready">Available</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-cancelled">86ed (Unavailable)</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.IsAvailable || canRestoreAvailability)
                                    {
                                        <button class="btn btn-sm btn-outline-warning" disabled="@busy" @onclick="() => ToggleAvailable(item)">
                                            @(item.IsAvailable ? "86 Item" : "Restore (68)")
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="small text-muted" title="Only Manager or Admin can restore an 86ed item">Restore (68) · Manager/Admin</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private bool failed, isAdmin, isManager, canRestoreAvailability, allowNegativeAdjustment, busy;
    private string actor = "unknown", adjustmentReason = "", adjustmentOverrideReason = "";
    private string newItemName = "", newItemUnit = "piece";
    private string deliveryReference = "", deliveryNote = "", countReason = "";
    private string receiptKey = Guid.NewGuid().ToString("N"), countKey = Guid.NewGuid().ToString("N");
    private string? message;
    private IReadOnlyList<InventoryBalance> balances = [];
    private IReadOnlyList<InventoryItem> items = [];
    private IReadOnlyList<StockMovementView> movements = [];
    private IReadOnlyList<InventoryCountView> counts = [];
    private IReadOnlyList<MenuCategory> categories = [];
    private InventoryReadinessReport? readiness;
    private Guid adjustItemId, receiveItemId, countItemId;
    private decimal adjustment, newMinimumStock;
    private decimal receivedQuantity = 1, countedQuantity;

    private bool HasActiveInventoryItems => items.Any(x => x.IsActive);

    protected override async Task OnInitializedAsync()
    {
        var state = await Authentication.GetAuthenticationStateAsync();
        actor = state.User.Identity?.Name ?? "unknown";
        isAdmin = state.User.IsInRole(RomsRoles.Admin);
        isManager = state.User.IsInRole(RomsRoles.Manager);
        canRestoreAvailability = isAdmin || isManager;
        await Load();
    }

    private async Task Load()
    {
        balances = await InventoryService.GetBalancesAsync();
        items = await InventoryService.GetItemsAsync();
        categories = await CatalogService.GetCategoriesAsync();
        movements = await InventoryService.GetRecentMovementsAsync();
        counts = await InventoryService.GetRecentCountsAsync();
        if (isAdmin)
            readiness = await InventoryService.EvaluateReadinessAsync(actor);

        var activeItems = items.Where(x => x.IsActive).ToList();
        if (!activeItems.Any(x => x.Id == adjustItemId))
            adjustItemId = activeItems.FirstOrDefault()?.Id ?? Guid.Empty;
        if (!activeItems.Any(x => x.Id == receiveItemId))
            receiveItemId = activeItems.FirstOrDefault()?.Id ?? Guid.Empty;
        if (!activeItems.Any(x => x.Id == countItemId))
            countItemId = activeItems.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private Task SaveItem() => Run(async () => {
        await InventoryService.SaveItemAsync(new InventoryItem
        {
            Name = newItemName,
            Unit = string.IsNullOrWhiteSpace(newItemUnit) ? "piece" : newItemUnit,
            MinimumStock = newMinimumStock
        }, actor);
        newItemName = "";
        newItemUnit = "piece";
        newMinimumStock = 0;
    });

    private Task Receive()
    {
        if (receiveItemId == Guid.Empty) return Task.CompletedTask;
        return Run(async () =>
        {
            await InventoryService.ReceiveAsync(
                receiveItemId,
                receivedQuantity,
                deliveryReference,
                deliveryNote,
                actor,
                receiptKey);
            receivedQuantity = 1;
            deliveryReference = "";
            deliveryNote = "";
            receiptKey = Guid.NewGuid().ToString("N");
        });
    }

    private Task ReconcileCount()
    {
        if (countItemId == Guid.Empty) return Task.CompletedTask;
        return Run(async () =>
        {
            await InventoryService.ReconcileCountAsync(
                countItemId,
                countedQuantity,
                countReason,
                actor,
                countKey);
            countReason = "";
            countKey = Guid.NewGuid().ToString("N");
        });
    }

    private Task Adjust()
    {
        if (adjustItemId == Guid.Empty) return Task.CompletedTask;
        return Run(async () => {
            await InventoryService.AdjustAsync(
                adjustItemId,
                adjustment,
                adjustmentReason,
                actor,
                Guid.NewGuid().ToString("N"),
                allowNegativeStock: allowNegativeAdjustment,
                inventoryOverrideReason: adjustmentOverrideReason);
            adjustment = 0;
            adjustmentReason = "";
            adjustmentOverrideReason = "";
            allowNegativeAdjustment = false;
        });
    }

    private async Task ToggleAvailable(MenuItem item)
    {
        busy = true;
        message = null;
        failed = false;
        try
        {
            item.IsAvailable = !item.IsAvailable;
            await CatalogService.SaveMenuItemAsync(item, actor);
            message = $"Availability of '{item.Name}' updated successfully.";
            await Load();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            failed = true;
        }
        finally
        {
            busy = false;
        }
    }
    private static string Signed(decimal value) => value >= 0 ? $"+{value:N3}" : value.ToString("N3");
    private static string ReadinessClass(InventoryReadinessStatus status) => status switch
    {
        InventoryReadinessStatus.Pass => "status-approved",
        InventoryReadinessStatus.Blocked => "status-rejected",
        _ => "status-pending"
    };
    private static string ReadinessLabel(InventoryReadinessStatus status) => status switch
    {
        InventoryReadinessStatus.Pass => "Pass",
        InventoryReadinessStatus.Blocked => "Blocked",
        _ => "Manual gate"
    };

    private async Task Run(Func<Task> action)
    {
        if (busy) return;
        busy = true;
        try { await action(); message = "Saved."; failed = false; await Load(); }
        catch (Exception ex) { message = ex.Message; failed = true; }
        finally { busy = false; }
    }
}
