@page "/inventory"
@attribute [Authorize(Roles = "Admin")]
@inject IInventoryService InventoryService
@inject IOrderService Orders
@inject AuthenticationStateProvider Authentication
@inject IConfiguration Configuration

<PageTitle>Inventory</PageTitle><h1>Inventory</h1>
@if (!enabled)
{
    <div class="alert alert-info"><strong>Phase 2 is disabled.</strong> Enable <code>Features:Inventory:Enabled</code> only after recipes and stock units are verified during the workflow pilot.</div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(message)) { <div class="alert @(failed ? "alert-danger" : "alert-success")">@message</div> }
    <div class="admin-grid">
        <section class="panel"><h2>Add inventory item</h2><div class="user-form"><input class="form-control" placeholder="Name" @bind="newItem.Name" /><input class="form-control" placeholder="Unit (piece, g, ml)" @bind="newItem.Unit" /><input class="form-control" type="number" min="0" step="0.001" placeholder="Minimum stock" @bind="newItem.MinimumStock" /><button class="btn btn-primary touch-button" @onclick="SaveItem">Add item</button></div></section>
        <section class="panel"><h2>Stock adjustment</h2>@if (items.Count > 0) { <div class="user-form"><select class="form-select" @bind="adjustItemId">@foreach (var item in items.Where(x => x.IsActive)) { <option value="@item.Id">@item.Name</option> }</select><input class="form-control" type="number" step="0.001" placeholder="Quantity + or -" @bind="adjustment" /><input class="form-control" placeholder="Reason (required)" @bind="adjustmentReason" /><button class="btn btn-primary touch-button" @onclick="Adjust">Post adjustment</button></div> }</section>
        <section class="panel"><h2>Recipe ingredient</h2>@if (items.Count > 0 && menu.Count > 0) { <div class="user-form"><select class="form-select" @bind="recipeMenuId">@foreach (var item in menu) { <option value="@item.Id">@item.Name</option> }</select><select class="form-select" @bind="recipeInventoryId">@foreach (var item in items.Where(x => x.IsActive)) { <option value="@item.Id">@item.Name (@item.Unit)</option> }</select><input class="form-control" type="number" min="0.001" step="0.001" placeholder="Qty per menu item" @bind="recipeQuantity" /><button class="btn btn-primary touch-button" @onclick="SaveRecipe">Save ingredient</button></div> }</section>
    </div>
    <section class="panel mt-4"><h2>Current balances</h2>@if (balances.Count == 0) { <div class="empty-state">No inventory items have been configured.</div> } else { <div class="admin-list">@foreach (var item in balances) { <div class="@(item.IsLow ? "low-stock" : "")"><span>@item.Name</span><strong>@item.CurrentStock.ToString("N3") @item.Unit @if (item.IsLow) { <em>Low stock</em> }</strong></div> }</div> }</section>
}

@code {
    private bool enabled, failed; private string actor="unknown", adjustmentReason=""; private string? message; private IReadOnlyList<InventoryBalance> balances=[]; private IReadOnlyList<InventoryItem> items=[]; private IReadOnlyList<MenuItemChoice> menu=[]; private InventoryItem newItem=new(); private Guid adjustItemId, recipeMenuId, recipeInventoryId; private decimal adjustment, recipeQuantity=1;
    protected override async Task OnInitializedAsync(){enabled=Configuration.GetValue<bool>("Features:Inventory:Enabled");if(!enabled)return;var state=await Authentication.GetAuthenticationStateAsync();actor=state.User.Identity?.Name??"unknown";await Load();}
    private async Task Load(){balances=await InventoryService.GetBalancesAsync();items=await InventoryService.GetItemsAsync();menu=await Orders.GetMenuAsync();if(adjustItemId==Guid.Empty)adjustItemId=items.FirstOrDefault(x=>x.IsActive)?.Id??Guid.Empty;if(recipeInventoryId==Guid.Empty)recipeInventoryId=adjustItemId;if(recipeMenuId==Guid.Empty)recipeMenuId=menu.FirstOrDefault()?.Id??Guid.Empty;}
    private Task SaveItem()=>Run(async()=>{await InventoryService.SaveItemAsync(newItem,actor);newItem=new();});
    private Task Adjust()=>Run(async()=>{await InventoryService.AdjustAsync(adjustItemId,adjustment,adjustmentReason,actor,Guid.NewGuid().ToString("N"));adjustment=0;adjustmentReason="";});
    private Task SaveRecipe()=>Run(()=>InventoryService.SetRecipeIngredientAsync(recipeMenuId,recipeInventoryId,recipeQuantity,actor));
    private async Task Run(Func<Task> action){try{await action();message="Saved.";failed=false;await Load();}catch(Exception ex){message=ex.Message;failed=true;}}
}
