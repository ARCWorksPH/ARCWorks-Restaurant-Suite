@page "/inventory"
@attribute [Authorize(Roles = "Admin")]
@inject IInventoryService InventoryService
@inject IOrderService Orders
@inject AuthenticationStateProvider Authentication
@inject IConfiguration Configuration

<PageTitle>Inventory</PageTitle><h1>Inventory</h1>
@if (!enabled)
{
    <div class="alert alert-warning"><strong>Automatic stock deduction is paused.</strong> Configure and verify stock units, opening balances, and recipes here before enabling <code>Features:Inventory:Enabled</code>.</div>
}
@if (!string.IsNullOrWhiteSpace(message)) { <div class="alert @(failed ? "alert-danger" : "alert-success")">@message</div> }
<div class="admin-grid">
    <section class="panel">
        <h2>Add inventory item</h2>
        <div class="user-form">
            <input class="form-control" placeholder="Name" @bind="newItem.Name" />
            <select class="form-select" @bind="newItem.Unit">
                <option value="piece">piece</option>
                <option value="g">g</option>
                <option value="ml">ml</option>
            </select>
            <input class="form-control" type="number" min="0" step="0.001" placeholder="Minimum stock" @bind="newItem.MinimumStock" />
            <button class="btn btn-primary touch-button" @onclick="SaveItem">Add item</button>
        </div>
    </section>
    <section class="panel">
        <h2>Stock adjustment</h2>
        @if (HasActiveInventoryItems)
        {
            <div class="user-form">
                <select class="form-select" @bind="adjustItemId">
                    @foreach (var item in items.Where(x => x.IsActive))
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
                <input class="form-control" type="number" step="0.001" placeholder="Quantity + or -" @bind="adjustment" />
                <input class="form-control" placeholder="Reason (required)" @bind="adjustmentReason" />
                <button class="btn btn-primary touch-button" disabled="@(adjustItemId == Guid.Empty)" @onclick="Adjust">Post adjustment</button>
            </div>
        }
        else
        {
            <div class="empty-state py-3">No active inventory items are available. Activate or add an inventory item before posting adjustments.</div>
        }
    </section>
    <section class="panel">
        <h2>Recipe ingredient</h2>
        @if (HasActiveInventoryItems && menu.Count > 0)
        {
            <div class="user-form">
                <select class="form-select" @bind="recipeMenuId">
                    @foreach (var item in menu)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
                <select class="form-select" @bind="recipeInventoryId">
                    @foreach (var item in items.Where(x => x.IsActive))
                    {
                        <option value="@item.Id">@item.Name (@item.Unit)</option>
                    }
                </select>
                <input class="form-control" type="number" min="0.001" step="0.001" placeholder="Qty per menu item" @bind="recipeQuantity" />
                <button class="btn btn-primary touch-button" disabled="@(recipeInventoryId == Guid.Empty || recipeMenuId == Guid.Empty)" @onclick="SaveRecipe">Save ingredient</button>
            </div>
        }
        else if (!HasActiveInventoryItems)
        {
            <div class="empty-state py-3">No active inventory items are available for recipe configuration.</div>
        }
        else
        {
            <div class="empty-state py-3">No menu items are available for recipe configuration.</div>
        }
    </section>
</div>
<section class="panel mt-4">
    <h2>Current balances</h2>
    @if (balances.Count == 0)
    {
        <div class="empty-state">No inventory items have been configured.</div>
    }
    else
    {
        <div class="admin-list">
            @foreach (var item in balances)
            {
                <div class="@(item.IsLow ? "low-stock" : "")">
                    <span>@item.Name</span>
                    <strong>@item.CurrentStock.ToString("N3") @item.Unit @if (item.IsLow) { <em>Low stock</em> }</strong>
                </div>
            }
        </div>
    }
</section>

@code {
    private bool enabled, failed;
    private string actor = "unknown", adjustmentReason = "";
    private string? message;
    private IReadOnlyList<InventoryBalance> balances = [];
    private IReadOnlyList<InventoryItem> items = [];
    private IReadOnlyList<MenuItemChoice> menu = [];
    private InventoryItem newItem = new InventoryItem { Unit = "piece" };
    private Guid adjustItemId, recipeMenuId, recipeInventoryId;
    private decimal adjustment, recipeQuantity = 1;

    private bool HasActiveInventoryItems => items.Any(x => x.IsActive);

    protected override async Task OnInitializedAsync()
    {
        enabled = Configuration.GetValue<bool>("Features:Inventory:Enabled");
        var state = await Authentication.GetAuthenticationStateAsync();
        actor = state.User.Identity?.Name ?? "unknown";
        await Load();
    }

    private async Task Load()
    {
        balances = await InventoryService.GetBalancesAsync();
        items = await InventoryService.GetItemsAsync();
        menu = await Orders.GetMenuAsync();

        var activeItems = items.Where(x => x.IsActive).ToList();
        if (!activeItems.Any(x => x.Id == adjustItemId))
            adjustItemId = activeItems.FirstOrDefault()?.Id ?? Guid.Empty;
        if (!activeItems.Any(x => x.Id == recipeInventoryId))
            recipeInventoryId = activeItems.FirstOrDefault()?.Id ?? Guid.Empty;
        if (!menu.Any(x => x.Id == recipeMenuId))
            recipeMenuId = menu.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private Task SaveItem() => Run(async () => {
        if (string.IsNullOrWhiteSpace(newItem.Unit)) newItem.Unit = "piece";
        await InventoryService.SaveItemAsync(newItem, actor);
        newItem = new InventoryItem { Unit = "piece" };
    });

    private Task Adjust() => Run(async () => {
        if (adjustItemId == Guid.Empty) return;
        await InventoryService.AdjustAsync(adjustItemId, adjustment, adjustmentReason, actor, Guid.NewGuid().ToString("N"));
        adjustment = 0;
        adjustmentReason = "";
    });

    private Task SaveRecipe() => Run(() => {
        if (recipeMenuId == Guid.Empty || recipeInventoryId == Guid.Empty) return Task.CompletedTask;
        return InventoryService.SetRecipeIngredientAsync(recipeMenuId, recipeInventoryId, recipeQuantity, actor);
    });

    private async Task Run(Func<Task> action)
    {
        try { await action(); message = "Saved."; failed = false; await Load(); }
        catch (Exception ex) { message = ex.Message; failed = true; }
    }
}
