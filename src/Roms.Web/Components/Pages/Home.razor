@page "/"
@attribute [Authorize]
<PageTitle>@ProductBrand.Name Dashboard</PageTitle>

<h1>Restaurant operations</h1>
<p class="lead">Fast, touch-friendly ordering from table to kitchen.</p>

<AuthorizeView>
    <Authorized Context="authState">
        <div class="action-grid">
            <a class="action-card" href="attendance"><strong>My Attendance</strong><span>Clock in, clock out, and view your schedule</span></a>
            <AuthorizeView Policy="WaiterOrAdmin"><a class="action-card" href="tables"><strong>Tables & Orders</strong><span>Take orders and serve ready meals</span></a></AuthorizeView>
            <AuthorizeView Policy="KitchenOrAdmin"><a class="action-card" href="kitchen"><strong>Kitchen Display</strong><span>Prepare incoming orders</span></a></AuthorizeView>
            <AuthorizeView Roles="Admin"><a class="action-card" href="admin/catalog"><strong>Administration</strong><span>Manage tables, categories, and menu</span></a></AuthorizeView>
            <AuthorizeView Roles="Admin,Manager"><a class="action-card" href="admin/payments"><strong>Pending Payments</strong><span>Review served orders and confirm payment</span></a></AuthorizeView>
            <AuthorizeView Roles="Admin"><a class="action-card" href="reports"><strong>Order-value Reports</strong><span>Review completed order performance</span></a></AuthorizeView>
            <AuthorizeView Roles="Admin"><a class="action-card" href="admin/attendance"><strong>Staff Schedule</strong><span>Schedule staff and see who is present</span></a></AuthorizeView>
        </div>
    </Authorized>
    <NotAuthorized><a class="btn btn-primary btn-lg touch-button" href="Account/Login">Staff login</a></NotAuthorized>
</AuthorizeView>
