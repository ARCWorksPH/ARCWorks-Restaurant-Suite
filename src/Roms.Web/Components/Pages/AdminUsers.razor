@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@inject UserManager<ApplicationUser> UserManager
<PageTitle>Users</PageTitle><h1>Staff users</h1>
@if (!string.IsNullOrEmpty(message)) { <div class="alert @(failed ? "alert-danger" : "alert-success")">@message</div> }
<section class="panel"><h2>Add staff member</h2><div class="user-form"><input class="form-control" placeholder="Username" @bind="username" /><input class="form-control" placeholder="Display name" @bind="displayName" /><input class="form-control" type="password" placeholder="Temporary password" @bind="password" /><select class="form-select" @bind="role"><option value="Waiter">Waiter</option><option value="Kitchen">Kitchen</option><option value="Admin">Admin</option></select><button class="btn btn-primary touch-button" @onclick="Create">Create user</button></div></section>
<section class="panel mt-4"><div class="admin-list">@foreach (var user in users) { <div><span><strong>@user.DisplayName</strong> · @user.UserName · @roles.GetValueOrDefault(user.Id,"No role")</span><button class="btn btn-sm @(user.IsActive?"btn-outline-success":"btn-outline-secondary")" @onclick="() => Toggle(user)">@(user.IsActive?"Active":"Inactive")</button></div> }</div></section>
@code { private List<ApplicationUser> users=[]; private Dictionary<string,string> roles=[]; private string username="",displayName="",password="",role=RomsRoles.Waiter; private string? message; private bool failed;
 protected override async Task OnInitializedAsync()=>await Load(); private async Task Load(){users=await UserManager.Users.OrderBy(x=>x.DisplayName).ToListAsync();roles.Clear();foreach(var u in users)roles[u.Id]=(await UserManager.GetRolesAsync(u)).FirstOrDefault()??"No role";}
 private async Task Toggle(ApplicationUser user){user.IsActive=!user.IsActive;var r=await UserManager.UpdateAsync(user);if(r.Succeeded&&!user.IsActive)await UserManager.UpdateSecurityStampAsync(user);message=r.Succeeded?"User updated.":string.Join("; ",r.Errors.Select(x=>x.Description));failed=!r.Succeeded;await Load();}
 private async Task Create(){try{var u=new ApplicationUser{UserName=username.Trim(),DisplayName=displayName.Trim(),EmailConfirmed=true};var r=await UserManager.CreateAsync(u,password);if(!r.Succeeded)throw new InvalidOperationException(string.Join("; ",r.Errors.Select(x=>x.Description)));r=await UserManager.AddToRoleAsync(u,role);if(!r.Succeeded)throw new InvalidOperationException(string.Join("; ",r.Errors.Select(x=>x.Description)));username=displayName=password="";message="User created.";failed=false;await Load();}catch(Exception ex){message=ex.Message;failed=true;}} }
