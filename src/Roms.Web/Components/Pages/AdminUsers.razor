@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider Authentication
@inject IDbContextFactory<Roms.Infrastructure.Persistence.RomsDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Users</PageTitle>

<div class="page-heading">
    <div>
        <h1>Staff users</h1>
        <p>Manage access without erasing staff identity or historical records.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(failed ? "alert-danger" : "alert-success")">@message</div>
}

<section class="panel">
    <h2>Add staff member</h2>
    <div class="user-form">
        <input class="form-control" placeholder="Username" @bind="username" />
        <input class="form-control" placeholder="Display name" @bind="displayName" />
        <input class="form-control" type="password" placeholder="Temporary password" @bind="password" />
        <select class="form-select" @bind="role">
            <option value="Waiter">Waiter</option>
            <option value="Kitchen">Kitchen</option>
            <option value="Manager">Manager</option>
            <option value="Admin">Admin</option>
        </select>
        <button class="btn btn-primary touch-button" @onclick="Create">Create user</button>
    </div>
</section>

<section class="panel mt-4">
    <div class="d-flex justify-content-between align-items-center gap-3">
        <h2 class="m-0">Staff access</h2>
        <small class="text-muted">Removed staff are hidden here, but their account and audit history remain preserved.</small>
    </div>
    <div class="admin-list">
        @foreach (var user in users)
        {
            <div class="user-row">
                <span>
                    <strong>@user.DisplayName</strong> · @user.UserName · @roles.GetValueOrDefault(user.Id, "No role")
                    <small class="d-block text-muted">@(user.IsActive ? "Access enabled" : "Access removed; record retained")</small>
                </span>
                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        @onclick="() => Toggle(user)"
                        aria-label="Remove access for @user.DisplayName">
                    Remove access
                </button>
            </div>
        }
    </div>
</section>

@code {
    private List<ApplicationUser> users = [];
    private Dictionary<string, string> roles = [];
    private string username = "";
    private string displayName = "";
    private string password = "";
    private string role = RomsRoles.Waiter;
    private string? message;
    private bool failed;
    private string actor = "unknown";

    protected override async Task OnInitializedAsync()
    {
        var state = await Authentication.GetAuthenticationStateAsync();
        actor = state.User.Identity?.Name ?? "unknown";
        await Load();
    }

    private async Task Load()
    {
        users = await UserManager.Users.Where(x => x.IsActive).OrderBy(x => x.DisplayName).ToListAsync();
        roles.Clear();
        foreach (var user in users)
        {
            roles[user.Id] = (await UserManager.GetRolesAsync(user)).FirstOrDefault() ?? "No role";
        }
    }

    // This is a soft removal: the Identity row stays in place so order, attendance,
    // and audit history retain their original actor. The former username is retained,
    // while the active login name is released for a future employee.
    private async Task Toggle(ApplicationUser user)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Remove access for {user.DisplayName}? The account and history will be retained.")) return;
        var oldUserName = user.UserName ?? "staff";
        user.ArchivedUserName = oldUserName;
        user.UserName = ApplicationUser.BuildArchivedUserName(user.Id, oldUserName);
        user.NormalizedUserName = UserManager.NormalizeName(user.UserName);
        user.IsActive = false;
        user.ActiveSessionId = null;
        user.SessionLastActivityUtc = null;
        var result = await UserManager.UpdateAsync(user);
        if (result.Succeeded && !user.IsActive)
        {
            await UserManager.UpdateSecurityStampAsync(user);
            await using var db = await DbFactory.CreateDbContextAsync();
            db.AuditEntries.Add(new Roms.Domain.AuditEntry
            {
                ActorId = actor,
                Action = "RemoveUserAccess",
                EntityType = nameof(ApplicationUser),
                EntityId = user.Id,
                OldValuesJson = System.Text.Json.JsonSerializer.Serialize(new { IsActive = true, UserName = oldUserName }),
                NewValuesJson = System.Text.Json.JsonSerializer.Serialize(new { IsActive = false, ArchivedUserName = oldUserName }),
                OccurredUtc = DateTime.UtcNow
            });
            await db.SaveChangesAsync();
        }

        message = result.Succeeded
            ? "User access removed. The account and history were retained."
            : string.Join("; ", result.Errors.Select(x => x.Description));
        failed = !result.Succeeded;
        await Load();
    }

    private async Task Create()
    {
        try
        {
            var user = new ApplicationUser
            {
                UserName = username.Trim(),
                DisplayName = displayName.Trim(),
                EmailConfirmed = true,
                MustChangePassword = true
            };
            var result = await UserManager.CreateAsync(user, password);
            if (!result.Succeeded)
                throw new InvalidOperationException(string.Join("; ", result.Errors.Select(x => x.Description)));

            result = await UserManager.AddToRoleAsync(user, role);
            if (!result.Succeeded)
                throw new InvalidOperationException(string.Join("; ", result.Errors.Select(x => x.Description)));

            username = displayName = password = "";
            message = "User created. They must replace the temporary password at first login.";
            failed = false;
            await Load();
        }
        catch (Exception ex)
        {
            message = ex.Message;
            failed = true;
        }
    }

}
