@page "/tables"
@attribute [Authorize(Policy = "WaiterOrAdmin")]
@inject IOrderService Orders
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
@inject OrderEventBus Events
@implements IDisposable

<PageTitle>Tables</PageTitle>
<div class="page-heading"><div><h1>Tables</h1><p>Select a table to open its order.</p></div><button class="btn btn-outline-primary touch-button" @onclick="Load">Refresh</button></div>
@if (!string.IsNullOrEmpty(error)) { <div class="alert alert-danger">@error</div> }
@if (tables is null) { <p>Loading tables…</p> }
else if (tables.Count == 0) { <div class="empty-state">No active tables. Ask an administrator to configure them.</div> }
else
{
    <div class="table-grid">
        @foreach (var table in tables)
        {
            <button class="table-card status-@table.Status.ToString().ToLowerInvariant()" disabled="@IsLocked(table)" @onclick="() => Open(table)">
                <strong>Table @table.Number</strong><span>@Label(table.Status)</span>
                @if (table.ActiveOrderId is not null) { <small>Waiter: @table.WaiterName</small> }
                @if (IsLocked(table)) { <small>Locked</small> }
                @if (table.Total > 0) { <small>₱@table.Total.ToString("N2")</small> }
            </button>
        }
    </div>
}

@code {
    private IReadOnlyList<TableCard>? tables;
    private string? error; private string actor = "unknown"; private bool isAdmin;
    protected override async Task OnInitializedAsync() { var state = await Authentication.GetAuthenticationStateAsync(); actor = state.User.Identity?.Name ?? "unknown"; isAdmin = state.User.IsInRole(RomsRoles.Admin); Events.Changed += OnChanged; await Load(); }
    private async Task Load() { try { tables = await Orders.GetTablesAsync(); error = null; } catch (Exception ex) { error = ex.Message; } }
    private async Task Open(TableCard table)
    {
        try {
            var id = table.ActiveOrderId;
            if (id is null) id = await Orders.GetOrCreateDraftAsync(table.Id, actor);
            Navigation.NavigateTo($"orders/{id}");
        } catch (Exception ex) { error = ex.Message; }
    }
    private void OnChanged(OrderEvent message) => _ = InvokeAsync(async () => { await Load(); StateHasChanged(); });
    private bool IsLocked(TableCard table) => table.ActiveOrderId is not null && !isAdmin && !string.Equals(table.WaiterId, actor, StringComparison.OrdinalIgnoreCase);
    private static string Label(TableStatus value) => value switch { TableStatus.PendingPayment => "Pending payment", TableStatus.ReadyToServe => "Ready to serve", TableStatus.Preparing => "Preparing", TableStatus.Occupied => "Occupied", _ => "Available" };
    public void Dispose() => Events.Changed -= OnChanged;
}
