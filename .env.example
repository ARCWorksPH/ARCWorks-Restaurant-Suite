COMPOSE_PROJECT_NAME=arcworks-resto-main
INSTANCE_ID=arcworks-resto-main
ROMS_HOST=roms.example.com
ROMS_HOST_PORT=7070
ROMS_IMAGE=roms:local
DB_SERVER_ID=1
DB_NAME=roms
DB_USER=roms
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-strong-password
ADMIN_DISPLAY_NAME=ARCWorks Restaurant Suite Administrator
OLLAMA_MEMORY_LIMIT=16g
OLLAMA_CPU_LIMIT=12.0
OLLAMA_MODEL=qwen2.5:3b
AI_ENABLED=false
AI_HOLD=true
AI_MAX_CONCURRENT_REQUESTS=2
AI_REQUESTS_PER_MINUTE=6
ROMS_ALLOWED_HOSTS=roms.arkworksph.online;app;localhost;127.0.0.1
CLOUDFLARE_TUNNEL_TOKEN_FILE=./.secrets/cloudflare-tunnel-token
OLLAMA_VOLUME_NAME=arcworks-resto-main_ollama
MARIADB_VOLUME_NAME=arcworks-resto-main_mariadb-data
DATA_PROTECTION_VOLUME_NAME=arcworks-resto-main_data-protection-keys
MONITOR_VOLUME_NAME=arcworks-resto-main_monitor-data
CADDY_DATA_VOLUME_NAME=arcworks-resto-main_caddy-data
CADDY_CONFIG_VOLUME_NAME=arcworks-resto-main_caddy-config
# Only needed when the workstation also publishes the portfolio through this tunnel.
PORTFOLIO_NETWORK_NAME=arcworks-portfolio-net
